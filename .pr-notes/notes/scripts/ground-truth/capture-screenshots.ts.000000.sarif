            }
          ],
          "workItemUris": [
            "GB-1101"
          ],
          "partialFingerprints": {
            "prNoteAnchor/v1": "4dd24621f0227425bbc3ac938bbbce70"
          }
        },
        {
          "ruleId": "review-note",
          "ruleIndex": 0,
          "kind": "informational",
          "level": "none",
          "guid": "mry9zi54z64vz63f",
          "message": {
            "text": "The port scan skips busy ports because the range is shared with the rest of the machine.\n\nThe harness walks one port per scene upward from 4196, and the server is launched with --strict-port, so an unrelated local process sitting anywhere in that ~47-port window used to fail exactly one scene with a bare EADDRINUSE. That is easy to miss in a 47-scene run, and the failure is quiet in the worst way: the scene keeps its stale actual from a previous capture, so the comparison silently comes from old bytes rather than the current UI.\n\nHit for real: a server from an unrelated project on this machine was holding 4209 mid-run.\n\nAn OS-assigned ephemeral port would avoid the scan entirely, but the port has to be known before the server starts (it is passed in on the command line), so probing is the option that fits. The 100-port ceiling just bounds the search rather than spinning forever.",
            "markdown": "The port scan skips busy ports because the range is shared with the rest of the machine.\n\nThe harness walks one port per scene upward from 4196, and the server is launched with `--strict-port`, so an unrelated local process sitting anywhere in that ~47-port window used to fail exactly one scene with a bare EADDRINUSE. That is easy to miss in a 47-scene run, and the failure is quiet in the worst way: the scene keeps its **stale** actual from a previous capture, so the comparison silently comes from old bytes rather than the current UI.\n\nHit for real: a server from an unrelated project on this machine was holding 4209 mid-run.\n\nAn OS-assigned ephemeral port would avoid the scan entirely, but the port has to be known *before* the server starts (it is passed in on the command line), so probing is the option that fits. The 100-port ceiling just bounds the search rather than spinning forever."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "scripts/ground-truth/capture-screenshots.ts"
                },
                "region": {
                  "startLine": 105,
                  "endLine": 122,
                  "snippet": {
                    "text": "/** Whether a local TCP port can be bound right now. */\nfunction isPortFree(port: number): Promise<boolean> {\n  return new Promise(resolve => {\n    const probe = createServer();\n    probe.once('error', () => { resolve(false); });\n    probe.once('listening', () => { probe.close(() => { resolve(true); }); });\n    probe.listen(port, '127.0.0.1');\n  });\n}\n\n/** The first free port at or above `from`, so an unrelated process squatting\n *  inside the scan range costs a port rather than a scene. */\nasync function nextFreePort(from: number): Promise<number> {\n  for (let port = from; port < from + 100; port++) {\n    if (await isPortFree(port)) return port;\n  }\n  throw new Error(`no free port found in ${String(from)}..${String(from + 99)}`);\n}"
                  }
                }
              }
            }
          ],
