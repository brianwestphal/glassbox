      "results": [
        {
          "ruleId": "review-note",
          "ruleIndex": 0,
          "kind": "informational",
          "level": "none",
          "guid": "mt9ekutvt19gvm3p",
          "message": {
            "text": "Line-number gutter contrast was raised to WCAG AA across all 16 themes (here + each theme in src/themes/built-in.ts), but the sidebar file-status label colors were only fixed for Dark/Light — a deliberate asymmetry.\n\ngutter-text styles only the line-number gutter, so lightening it per theme is safe: it doesn't touch any theme's syntax-highlighting brand palette. The failing values were pervasive and intentional (as low as 1.80:1); each was nudged the smallest hue-preserving amount to clear ~4.6:1, keeping line numbers subtle-but-legible.\n\nThe status-label colors, by contrast, reuse the shared --yellow/--green syntax tokens. Darkening those in brand-replica themes (Solarized, Gruvbox) would shift their whole palette off-spec, so those themes' failing badges were left for a follow-up (GB-1185) that fixes them without breaking palette fidelity. Guarded by tests/unit/themes/theme-contrast.test.ts.\n",
            "markdown": "Line-number gutter contrast was raised to WCAG AA across all 16 themes (here + each theme in `src/themes/built-in.ts`), but the sidebar file-status label colors were only fixed for Dark/Light — a deliberate asymmetry.\n\n`gutter-text` styles **only** the line-number gutter, so lightening it per theme is safe: it doesn't touch any theme's syntax-highlighting brand palette. The failing values were pervasive and intentional (as low as 1.80:1); each was nudged the smallest hue-preserving amount to clear ~4.6:1, keeping line numbers subtle-but-legible.\n\nThe status-label colors, by contrast, reuse the shared `--yellow`/`--green` **syntax** tokens. Darkening those in brand-replica themes (Solarized, Gruvbox) would shift their whole palette off-spec, so those themes' failing badges were left for a follow-up (GB-1185) that fixes them without breaking palette fidelity. Guarded by `tests/unit/themes/theme-contrast.test.ts`.\n"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/client/styles/_variables.scss"
                },
                "region": {
                  "startLine": 25,
                  "endLine": 25,
                  "snippet": {
                    "text": "  --gutter-text: #8282a6; // GB-1184: was #555577 (2.40:1 line numbers); now clears WCAG AA (4.62:1)"
                  }
                }
              }
            }
          ],
          "properties": {
            "tags": [
              "rationale"
            ]
          },
          "workItemUris": [
            "GB-1184"
          ],
          "partialFingerprints": {
            "prNoteAnchor/v1": "07928765f71c0c886b025d06f67e49ca"
          }
        }
