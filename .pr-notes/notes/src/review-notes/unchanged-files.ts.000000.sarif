  "runs": [
    {
      "tool": {
        "driver": {
          "name": "Hot Sheet",
          "rules": [
            {
              "id": "review-note",
              "name": "ReviewNote",
              "shortDescription": {
                "text": "AI-authored, line-anchored review note."
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "review-note",
          "ruleIndex": 0,
          "kind": "informational",
          "level": "none",
          "guid": "mt2ggsj3zykhumj5",
          "message": {
            "text": "An unchanged note-bearing file is surfaced only when its note shard is part of THIS review's diff — scoped to the review's own note changes, not every file that ever had a note on disk (the GB-1137 follow-up fix).\n\nAn AI writes a note in the same changeset as the work, so .pr-notes/notes/<src>.NNNNNN.sarif appears in the diff exactly when its note belongs to this review. collectNoteOnlyFiles maps each note shard in diffs back to its source via noteSourceForShardPath and, if that source wasn't itself changed, synthesizes an unchanged FileDiff whose single hunk is the WHOLE current file as context lines — so the note anchors at its exact line with zero special-casing downstream (/file/:id + reanchorReviewNotes + DiffView all work unchanged). Skips: deleted note shards, sources already in the diff, the .pr-notes/ store itself, and gone/unreadable sources (dropped, never fail the launch). Git modes only.",
            "markdown": "An unchanged note-bearing file is surfaced only when its note shard is part of THIS review's diff — scoped to the review's own note changes, not every file that ever had a note on disk (the GB-1137 follow-up fix).\n\nAn AI writes a note in the same changeset as the work, so `.pr-notes/notes/<src>.NNNNNN.sarif` appears in the diff exactly when its note belongs to this review. `collectNoteOnlyFiles` maps each note shard in `diffs` back to its source via `noteSourceForShardPath` and, if that source wasn't itself changed, synthesizes an `unchanged` FileDiff whose single hunk is the WHOLE current file as context lines — so the note anchors at its exact line with zero special-casing downstream (`/file/:id` + `reanchorReviewNotes` + `DiffView` all work unchanged). Skips: deleted note shards, sources already in the diff, the `.pr-notes/` store itself, and gone/unreadable sources (dropped, never fail the launch). Git modes only."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/review-notes/unchanged-files.ts"
                },
                "region": {
                  "startLine": 24,
                  "endLine": 46,
                  "snippet": {
                    "text": " */\nexport function collectNoteOnlyFiles(repoRoot: string, changedPaths: Set<string>): NoteOnlyFile[] {\n  const out: NoteOnlyFile[] = [];\n  for (const filePath of listFilesWithNotes(repoRoot)) {\n    if (changedPaths.has(filePath) || filePath.startsWith('.pr-notes/')) continue;\n    const abs = join(repoRoot, filePath);\n    if (!existsSync(abs)) continue;\n    let content: string;\n    try {\n      content = readFileSync(abs, 'utf-8');\n    } catch {\n      continue;\n    }\n    out.push({ filePath, diff: unchangedFileDiff(filePath, content) });\n  }\n  return out;\n}\n"
                  }
                }
              }
            }
          ],
          "properties": {
            "tags": [
              "rationale"
            ]
          },
          "workItemUris": [
            "GB-1137"
          ],
          "partialFingerprints": {
            "prNoteAnchor/v1": "1b2234135509d57b2be9ff179751aef1"
          }
        }
      ],
      "versionControlProvenance": [
        {
          "repositoryUri": "git@github.com:brianwestphal/glassbox.git",
          "revisionId": "6aaa2762fbd4812c2f13159e205327aceb5a2178",
          "branch": "main"
        }
      ]
    }
  ]
}
