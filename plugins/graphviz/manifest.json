{
  "id": "graphviz",
  "name": "Graphviz Diagrams",
  "version": "1.0.0",
  "entry": "index.js",
  "description": "Renders Graphviz .dot / .gv source to SVG server-side (via @viz-js/viz WASM, no DOM).",
  "author": "Glassbox",
  "contentTypes": [{ "extensions": [".dot", ".gv"] }],
  "preferences": [
    {
      "key": "engine",
      "label": "Layout engine",
      "type": "select",
      "default": "dot",
      "options": ["dot", "neato", "fdp", "circo", "twopi"],
      "description": "The Graphviz layout algorithm used to render diagrams."
    }
  ],
  "configLayout": [
    {
      "type": "group",
      "title": "Rendering",
      "items": [
        { "type": "preference", "key": "engine" },
        { "type": "spacer" },
        { "type": "label", "id": "engine-status", "text": "Not tested", "color": "transient" },
        { "type": "button", "id": "test-btn", "label": "Test renderer", "action": "test_renderer" }
      ]
    }
  ]
}
