#!/bin/bash
# `glassbox-difftool` — git-difftool bridge for Glassbox (Linux desktop install).
#
# Symlinked to PATH by the desktop app's "Install CLI" affordance:
#   ~/.local/bin/glassbox-difftool -> this script
#
# Thin wrapper around `cli-difftool.js` (see src/cli-difftool.ts for the why).
# Paths verified against the Linux .deb layout (GB-856):
#   <res>/resources/glassbox-difftool-linux  <- this script ($RESOURCES_DIR)
#   <res>/server/cli-difftool.js             <- the wrapper
#   /usr/bin/glassbox-node                   <- Node binary (../../../bin)
set -e

SCRIPT_PATH="$(readlink -f "$0")"
RESOURCES_DIR="$(dirname "$SCRIPT_PATH")"
APP_ROOT="$(dirname "$RESOURCES_DIR")"          # .../usr/lib/Glassbox
BIN_DIR="$(cd "$RESOURCES_DIR/../../../bin" 2>/dev/null && pwd || echo "$APP_ROOT/bin")"
NODE_BIN="$BIN_DIR/glassbox-node"
CLI_DIFFTOOL_JS="$APP_ROOT/server/cli-difftool.js"

exec "$NODE_BIN" "$CLI_DIFFTOOL_JS" "$@"
